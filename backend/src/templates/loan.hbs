<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Udlånskvittering</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #f4f4f4;
      }
      .container {
        max-width: 700px;
        margin: 20px auto;
        background: #ffffff;
        padding: 24px 32px;
        border: 1px solid #dddddd;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }
      .header {
        text-align: center;
        margin-top: 10px;
        margin-bottom: 20px;
      }
      .header img {
        width: 180px;
        max-width: 180px;
        height: auto;
      }
      .title {
        font-size: 22px;
        font-weight: bold;
        margin: 20px 0;
        text-align: center;
      }
      .line {
        border: none;
        border-top: 1.5px solid #aaaaaa;
        margin: 20px 0;
      }
      .info-table {
        width: 100%;
        border-collapse: collapse;
      }
      .info-table td {
        width: 50%;
        vertical-align: top;
        padding: 8px 10px;
      }
      .info-table p {
        margin: 0;
        font-size: 16px;
      }
      .info-table span {
        font-weight: bold;
        display: inline-block;
        min-width: 110px;
      }
      .products {
        margin-top: 10px;
      }
      .products h3 {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 12px;
      }
      .product-table {
        width: 100%;
        border-collapse: collapse;
      }
      .product-table td {
        padding: 8px 0;
        vertical-align: middle;
      }
      .product-table .product-name {
        font-size: 16px;
        font-weight: 500;
        text-align: left;
      }
      .product-table .barcode-col {
        text-align: right;
      }
      .product-table .barcode-col img {
        display: inline-block;
        height: 50px;
      }
      .footer {
        margin-top: 40px;
        text-align: center;
        font-size: 12px;
        color: #777777;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        <img
          src="https://bb.sde.dk/img/sde-logotype.png"
          alt="Syddansk Erhvervsskole Logo"
          width="180"
          style="width: 180px; max-width: 180px; height: auto;"
        />
      </div>

      <hr class="line" />

      <div class="title">Udlånskvittering</div>

      <table class="info-table" role="presentation" border="0" cellpadding="0" cellspacing="0">
        <tr>
          <td>
            <p><span>Låner:</span> {{users_loans_user_idTousers.username}}</p>
          </td>
          <td>
            <p><span>Udlånsdato:</span> {{date_created}}</p>
          </td>
        </tr>
        <tr>
          <td>
            <p>
              <span>Udlåner:</span>
              {{#if helpdesk_personel}}
                {{helpdesk_personel.username}}
              {{else}}
                Ingen
              {{/if}}
            </p>
          </td>
          <td>
            <p><span>Afleveringsdato:</span> {{return_date}}</p>
          </td>
        </tr>
      </table>

      <hr class="line" />

      <div class="products">
        <h3>Produkter:</h3>
        <table class="product-table" role="presentation" border="0" cellpadding="0" cellspacing="0">
          {{#each itemsInLoan}}
            <tr>
              <td class="product-name">
                {{this.Produkt}}
              </td>
              <td class="barcode-col">
                {{#if this.Stregkode}}
                  <img
                    src="https://api-bwipjs.metafloor.com/?bcid=code128&text={{this.Stregkode}}&scale=3&height=10&includetext"
                    alt="{{this.Stregkode}}"
                    height="50"
                    style="height: 50px; border: 0;"
                  />
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </table>
      </div>

      <div class="footer">
        <p>Udlånskvittering udskrevet fra SDE Udlånsportal</p>
      </div>
    </div>
  </body>
</html>